{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Daily active cell-days for one province: every date in range, with status (parallel arrays)","type":"object","required":["schema_version","province_id","metric","dates","status","modis","viirs_snpp","viirs_all"],"properties":{"schema_version":{"const":"1.0.0"},"province_id":{"type":"string","pattern":"^[A-Z]{2}-[A-Z0-9]{1,3}$"},"metric":{"const":"active_cell_days"},"dates":{"type":"array","items":{"type":"string","format":"date","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}},"status":{"type":"array","items":{"enum":["complete","partial","missing"]}},"modis":{"type":"array","items":{"type":["integer","null"],"minimum":0}},"viirs_snpp":{"type":"array","items":{"type":["integer","null"],"minimum":0}},"viirs_all":{"type":"array","items":{"type":["integer","null"],"minimum":0}}}}